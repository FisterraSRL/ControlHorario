{
  "name": "controlhorario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control de fichadas: detección de irregularidades sobre exportaciones QUICKPASS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "api": "node dist-api/api/main.js",
    "db:migrate": "node dist-api/api/migrar.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.4",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
