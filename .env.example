# ControlHorario — plantilla local. Ningún valor de este archivo es real.
# Copiar como `.env`; ese archivo está ignorado por git y nunca se comparte.

# Azure SQL compartida con Centraliza y FSTrack. ControlHorario sólo usa el esquema
# `[controlhorario]`; el runtime debe usar un principal miembro del rol homónimo.
DB_SERVER=SERVIDOR.database.windows.net
DB_PORT=1433
# Durante preflight/migración: identidad administradora. En runtime: usuario contenido
# miembro de [controlhorario_app], sin permisos globales sobre la base.
DB_USER=USUARIO_LIMITADO_CONTROLHORARIO
DB_PASSWORD=CAMBIAME
DB_NAME=BASE_COMPARTIDA
# DB_MAX_CONEXIONES=5

# API
API_PUERTO=8080
API_NIVEL_LOG=info
API_MIGRAR_AL_INICIAR=false
API_OPERADOR=servidor
# API_LIMITE_CUERPO_BYTES=33554432

# Sesión local por HTTP. En producción cambiar obligatoriamente a true; con un frontend en
# Vercel el SameSite deducido será `none` y la API rechazará arrancar si Secure sigue false.
API_COOKIE_SEGURA=false
# API_COOKIE_SESION=ch_sesion
# API_COOKIE_SAMESITE=none
# API_SESION_HORAS=12

# Certificados médicos: ruta persistente, nunca una carpeta pública.
API_DIR_ADJUNTOS=datos/adjuntos
# API_ADJUNTO_MAX_BYTES=10485760

# Local: la API sirve el bundle y no hay cruce de origen. En producción se reemplazan ambas
# URLs por `https://NOMBRE.vercel.app` y el directorio puede apuntar a una ruta inexistente.
APP_ORIGEN_FRONTEND=
APP_URL_PUBLICA=
API_DIR_ESTATICO=dist

# Dato personal opcional; sólo DNIs separados por coma. No commitear valores reales.
# EXCLUSIONES_INICIALES=

# Local/Docker usa el mismo origen. En Vercel reemplazar por la API HTTPS pública.
VITE_API_BASE_URL=/api

# Para crear el primer usuario de forma no interactiva. Definir sólo durante el comando y
# eliminar inmediatamente; nunca guardar una contraseña real en este archivo.
# CH_CONTRASENA=
