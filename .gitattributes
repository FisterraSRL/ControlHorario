* text=auto eol=lf

# Explicit, because these run inside Linux containers and a CRLF in them is not a
# cosmetic problem: bash reads the \r as part of the last token on every line, so
# `[ "$dia" = "01" ]` silently never matches and the shebang becomes a bad interpreter.
# `text=auto` above already covers it; this is here so that a future edit to that line
# cannot quietly take the container scripts with it.
*.sh    text eol=lf
Dockerfile text eol=lf

*.woff2 binary
*.png   binary
*.xlsx  binary
*.dump  binary
